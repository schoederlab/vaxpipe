<ROSETTASCRIPTS>
<SCOREFXNS>
<ScoreFunction name="beta_full" weights="beta">
<Reweight scoretype="coordinate_constraint" weight="%%cst_value%%"/>
<Reweight scoretype="res_type_constraint" weight="0.4"/>
</ScoreFunction>
</SCOREFXNS>
<TASKOPERATIONS>
<InitializeFromCommandline name="init"/>
<DesignAround name="des_around" design_shell="0.1" resnums="%%current_res%%" repack_shell="8.0"/>
<SeqprofConsensus name="pssm_cutoff" filename="%%pssm_full_path%%" min_aa_probability="0" probability_larger_than_current="0" convert_scores_to_probabilities="0"
keep_native="1"/>
</TASKOPERATIONS>
<MOVERS>
<SetupForSymmetry name="setup_symm" definition="%%sym%%"/>
<ConstraintSetMover name="add_CA_cst" cst_file="%%cst_full_path%%"/>
<FavorSequenceProfile name="FSP" scaling="none" weight="1" pssm="%%pssm_full_path%%" scorefxns="beta_full"/>
<SymMinMover name="min_all" scorefxn="beta_full" chi="1" bb="1" jump="0"/>
</MOVERS>
<FILTERS>
<ScoreType name="stability_score_full" scorefxn="beta_full" score_type="total_score" threshold="0.0"/>
<Delta name="delta_score_full" filter="stability_score_full" upper="1" lower="0" range="0.5"/>
#upper and lower are booleans. Delta filters out all the mutations that are worse or better by less than -0.55R.E.U
<Time name="timer"/>
<FilterScan name="filter_scan" scorefxn="beta_full" relax_mover="min_all" keep_native="1" task_operations="init,des_around,pssm_cutoff"
delta_filters="delta_score_full" delta="true" resfile_name="%%resfiles_path%%" report_all="1"
delta_filter_thresholds="-0.5,-1.0,-1.5,-2.0,-2.5,-3.0,-3.5,-4.0,-4.5,-5.0,-5.5,-6.0"
dump_pdb="0"/>
</FILTERS>
<PROTOCOLS>
<Add mover_name="setup_symm"/>
<Add filter="timer"/>
<Add mover_name="add_CA_cst"/>
<Add mover="FSP"/>
<Add filter="filter_scan"/>
<Add filter="timer"/>
</PROTOCOLS>
</ROSETTASCRIPTS>